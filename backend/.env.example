APP_ENV=development
LOG_LEVEL=debug
HTTP_ADDRESS=:8080
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=2097152
# Batas body untuk request multipart: 5 MB berkas ditambah ruang untuk boundary.
HTTP_MAX_UPLOAD_BYTES=6291456
HTTP_TRUST_PROXY=false
CORS_ALLOWED_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://gsnpeeps:change-me@postgres:5432/gsnpeeps?sslmode=disable
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_MIN_CONNECTIONS=2
POSTGRES_MAX_CONN_LIFETIME=30m
POSTGRES_HEALTH_TIMEOUT=3s

REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=10
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_HEALTH_TIMEOUT=3s

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL=8h
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REQUEST_LIMIT=120
AUTH_REQUEST_WINDOW=1m
AUTH_ARGON_MEMORY_KIB=65536
AUTH_ARGON_ITERATIONS=3
AUTH_ARGON_PARALLELISM=2
SEED_PASSWORD=replace-with-development-password

NEXTCLOUD_WEBDAV_URL=http://nextcloud/remote.php/dav/files/gsnpeeps-service
NEXTCLOUD_USERNAME=gsnpeeps-service
NEXTCLOUD_APP_PASSWORD=replace-with-nextcloud-app-password
NEXTCLOUD_ROOT_FOLDER=GSNpeeps
NEXTCLOUD_HTTP_TIMEOUT=20s
