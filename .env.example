APP_PORT=8080
APP_ENV=development
LOG_LEVEL=debug
CORS_ALLOWED_ORIGIN=http://localhost:8080

POSTGRES_DB=gsnpeeps
POSTGRES_USER=gsnpeeps
POSTGRES_PASSWORD=replace-with-a-strong-local-password

JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_LOGIN_RATE_LIMIT=10
SEED_PASSWORD=replace-with-development-password

# Kebijakan absensi: radius WFO (meter) dan jam kerja reguler. Default 500 meter dan
# 09.00-18.00 WIB; dapat diubah di sini tanpa deploy ulang kode.
ATTENDANCE_WFO_RADIUS_METERS=500
ATTENDANCE_WORK_START_HOUR=9
ATTENDANCE_WORK_START_MINUTE=0
ATTENDANCE_WORK_END_HOUR=18
ATTENDANCE_WORK_END_MINUTE=0

# STORAGE_DRIVER memilih adapter object storage aktif untuk backend-api/cron-worker: minio
# (default) atau nextcloud. Lihat docs/architecture/minio-integration.md.
STORAGE_DRIVER=minio
MINIO_ROOT_USER=gsnpeeps-service
MINIO_ROOT_PASSWORD=replace-with-a-strong-local-password
MINIO_BUCKET=gsnpeeps

# NEXTCLOUD_* hanya perlu diisi bila menjalankan `docker compose --profile nextcloud up`
# (STORAGE_DRIVER=nextcloud).
NEXTCLOUD_ADMIN_USER=gsnpeeps-service
NEXTCLOUD_ADMIN_PASSWORD=replace-with-a-strong-local-password
DOCKERHUB_NAMESPACE=user
TAG=latest